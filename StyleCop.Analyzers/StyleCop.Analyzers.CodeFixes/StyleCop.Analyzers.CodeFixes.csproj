<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard1.1</TargetFramework>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <PackageTargetFallback>portable-net45+win8</PackageTargetFallback>

    <!--
      netstandard1.1 is intentional: it keeps the analyzers loadable by Roslyn 1.2+ hosts (Visual Studio 2015 Update 2
      and later). Silence the .NET SDK's NETSDK1215 "not recommended" warning for that deliberate choice.
    -->
    <CheckNotRecommendedTargetFramework>false</CheckNotRecommendedTargetFramework>
    <RootNamespace>StyleCop.Analyzers</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <NuspecFile>StyleCop.Analyzers.nuspec</NuspecFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- This package intentionally uses SemVer 2. -->
    <NoWarn>$(NoWarn),NU5105</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!--
      Embed the portable PDB in the shipped assembly. Analyzers are loaded by the compiler and the IDE, not by the
      user's application, so a separate symbol package is rarely found. With the PDB inside the DLL, stack traces
      from analyzer hosts include file and line information, and a debugger finds the symbols without a symbol
      server. Debug builds keep a separate portable PDB (see Directory.Build.props), which code coverage uses.
    -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>..\StyleCop.Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\build\keys\StyleCopAnalyzers.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StyleCop.Analyzers\StyleCop.Analyzers.csproj" />
  </ItemGroup>

  <Target Name="SetNuspecProperties" AfterTargets="GetBuildVersion">
    <PropertyGroup>
      <NuspecProperties>id=StyleCop.Analyzers;configuration=$(Configuration);version=$(PackageVersion);tag=$(PackageVersion)</NuspecProperties>
    </PropertyGroup>
  </Target>

</Project>