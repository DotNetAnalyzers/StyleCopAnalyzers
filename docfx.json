{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "toc.yml"
        ]
      },
      {
        "src": "documentation",
        "files": [
          "**/*.md"
        ]
      },
      {
        "src": "documentation",
        "files": [
          "toc.yml"
        ],
        "dest": "navigation"
      }
    ],
    "resource": [
      {
        "src": "docs",
        "files": [
          "**/*"
        ],
        "exclude": [
          "**/*.md"
        ],
        "dest": "status"
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "StyleCop.Analyzers",
      "_appTitle": "StyleCop.Analyzers documentation",
      "_enableSearch": true,
      "_gitContribute": {
        "branch": "master"
      }
    }
  }
}
