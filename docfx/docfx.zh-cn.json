{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "src": "../documentation/zh-cn/navbar",
        "files": [
          "toc.yml"
        ]
      },
      {
        "src": "../documentation/zh-cn",
        "files": [
          "*.md"
        ]
      },
      {
        "src": "../documentation/zh-cn",
        "files": [
          "toc.yml"
        ],
        "dest": "navigation"
      }
    ],
    "resource": [
      {
        "src": "../docs",
        "files": [
          "**/*"
        ],
        "exclude": [
          "**/*.md"
        ],
        "dest": "status"
      }
    ],
    "dest": "../_site/zh-cn",
    "template": [
      "default",
      "modern",
      "../build/docfx/common",
      "../build/docfx/zh-cn"
    ],
    "globalMetadata": {
      "_appName": "StyleCop.Analyzers",
      "_appTitle": "StyleCop.Analyzers 文档",
      "_appFooter": "使用 <a href=\"https://dotnet.github.io/docfx\">DocFX</a> 生成",
      "_enableSearch": true,
      "_lang": "zh-CN",
      "_gitContribute": {
        "branch": "master"
      }
    }
  }
}
