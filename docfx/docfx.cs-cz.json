{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "src": "../documentation/cs-cz/navbar",
        "files": [
          "toc.yml"
        ]
      },
      {
        "src": "../documentation/cs-cz",
        "files": [
          "*.md"
        ]
      },
      {
        "src": "../documentation/cs-cz",
        "files": [
          "toc.yml"
        ],
        "dest": "navigation"
      }
    ],
    "resource": [
      {
        "src": "../docs",
        "files": [
          "**/*"
        ],
        "exclude": [
          "**/*.md"
        ],
        "dest": "status"
      }
    ],
    "dest": "../_site/cs-cz",
    "template": [
      "default",
      "modern",
      "../build/docfx/common",
      "../build/docfx/cs-cz"
    ],
    "globalMetadata": {
      "_appName": "StyleCop.Analyzers",
      "_appTitle": "Dokumentace StyleCop.Analyzers",
      "_appFooter": "Vytvořeno pomocí <a href=\"https://dotnet.github.io/docfx\">DocFX</a>",
      "_enableSearch": true,
      "_lang": "cs",
      "_gitContribute": {
        "branch": "master"
      }
    }
  }
}
