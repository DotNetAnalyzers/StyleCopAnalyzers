<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Local campaign tool only. It is intentionally absent from StyleCopAnalyzers.slnx so the solution build and CI
    do not compile or run it. Do not add a workflow job that runs mutate or repro.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RS1035</NoWarn>
    <CodeAnalysisRuleSet>../../StyleCop.Analyzers.Internal.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <ProjectReference Include="../../src/StyleCop.Analyzers.CodeFixes/StyleCop.Analyzers.CodeFixes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Seeds/**/*.cs" />
    <None Include="Seeds/**/*.cs" />
  </ItemGroup>
</Project>
